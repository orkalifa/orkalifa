{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx expo *)",
      "Bash(npx eas *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/apps/sunset-spots/scripts/quality-gate.mjs\"",
            "timeout": 300,
            "statusMessage": "Spotlight quality gate: tests, typecheck, lint"
          }
        ]
      }
    ]
  }
}
