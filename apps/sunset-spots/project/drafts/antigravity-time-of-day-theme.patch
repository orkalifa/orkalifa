+/**
+ * Returns the most recent sunset (<= `now`) and `now`'s sunrise.
+ * After sunset `getSunsetInfo` already rolls over to tomorrow's sunset, so detecting the
+ * post-sunset blue hour and pre-dawn night needs today's actual bounds.
+ */
+export function getDaySunBounds(lat: number, lon: number, now: Date = new Date()): DaySunBounds {
+  const t = now.getTime();
+  const today = getTimes(now, lat, lon);
+  let lastSunset = validDate(today.sunset);
+  if (lastSunset && lastSunset.getTime() > t) {
+    const yesterday = validDate(getTimes(new Date(t - DAY_MS), lat, lon).sunset);
+    lastSunset = yesterday && yesterday.getTime() <= t ? yesterday : null;
+  }
+  return { lastSunset, sunrise: validDate(today.sunrise) };
+}
