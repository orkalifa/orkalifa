+/** Approximate phase using Israel fallback coordinates before GPS resolves (keeps launch/loading chrome matched to the time of day). */
+export function getFallbackSkyPhase(now: Date = new Date()): SkyPhase {
+  const info = getSunsetInfo(FALLBACK_COORDS.lat, FALLBACK_COORDS.lon, now);
