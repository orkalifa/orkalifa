@@ -0,0 +1,95 @@
+/// <reference types="node" />
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { getDaySunBounds, getSunsetInfo } from '../src/lib/sun.ts';
+import { getSkyPhase, PHASE_THEMES, type SkyPhaseId } from '../src/theme.ts';
+
+const LAT = 31.905;
+const LON = 34.84;
+
+function phaseAt(isoUtc: string) {
+  const now = new Date(isoUtc);
+  const info = getSunsetInfo(LAT, LON, now)!;
+  const bounds = getDaySunBounds(LAT, LON, now);
+  return getSkyPhase(now, info.goldenHour, info.sunset, info.isTomorrow, bounds);
+}
+
+test('getSkyPhase transitions through afternoon, golden, blue hour, and night', () => {
+  // 2026-11-21 around 31.905, 34.84: sunset ~14:38 UTC (16:38 Israel time).
+  const afternoon = phaseAt('2026-11-21T12:30:00Z'); // 14:30 local
+  assert.equal(afternoon.id, 'afternoon');
+  assert.equal(afternoon.isDark, false);
+  assert.equal(afternoon.statusBarStyle, 'dark');
+
+  const golden = phaseAt('2026-11-21T14:25:00Z'); // 16:25 local (~13m before sunset)
+  assert.equal(golden.id, 'golden');
+  assert.equal(golden.isDark, false);
+
+  const blue = phaseAt('2026-11-21T14:55:00Z'); // 16:55 local (~17m after sunset)
+  assert.equal(blue.id, 'blue');
+  assert.equal(blue.isDark, false);
+
+  const night = phaseAt('2026-11-21T17:30:00Z'); // 19:30 local
+  assert.equal(night.id, 'night');
+  assert.equal(night.isDark, true);
+  assert.equal(night.statusBarStyle, 'light');
+
+  const predawn = phaseAt('2026-11-21T00:30:00Z'); // 02:30 local (before sunrise)
+  assert.equal(predawn.id, 'night');
+  assert.equal(predawn.isDark, true);
+});
+
+function luminance(hex: string): number {
+  const m = /^#([0-9a-f]{6})$/i.exec(hex);
+  assert.ok(m, `expected #RRGGBB hex, got ${hex}`);
+  const channels = [0, 1, 2].map((i) => {
+    const v = parseInt(m[1].slice(2 * i, 2 * i + 2), 16) / 255;
+    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
+}
+
+function contrastRatio(a: string, b: string): number {
+  const l1 = luminance(a);
+  const l2 = luminance(b);
+  return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
+}
+
+function rgbaToHexOver(rgba: string, bgHex: string): string {
+  const hexMatch = /^#([0-9a-f]{6})$/i.exec(rgba);
+  if (hexMatch) return rgba;
+  const m = /^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)$/i.exec(rgba);
+  assert.ok(m, `unexpected color format: ${rgba}`);
+  const a = m[4] === undefined ? 1 : Number(m[4]);
+  const bg = [0, 1, 2].map((i) => parseInt(bgHex.slice(1 + 2 * i, 3 + 2 * i), 16));
+  const out = [0, 1, 2].map((i) => Math.round(Number(m[1 + i]) * a + bg[i] * (1 - a)));
+  return `#${out.map((n) => n.toString(16).padStart(2, '0')).join('')}`;
+}
+
+test('all 4 phases keep >= 4.5:1 text contrast on HUD, sheets, cards, buttons, and map labels', () => {
+  for (const id of Object.keys(PHASE_THEMES) as SkyPhaseId[]) {
+    const t = PHASE_THEMES[id];
+    const hudBg = rgbaToHexOver(t.hud.bg, t.map.ground);
+    const badgeBg = rgbaToHexOver(t.badgeBg, hudBg);
+    assert.ok(contrastRatio(t.hud.time, hudBg) >= 4.5, `${id}: hud time`);
+    assert.ok(contrastRatio(t.hud.label, hudBg) >= 4.5, `${id}: hud label`);
+    assert.ok(contrastRatio(t.hud.meta, hudBg) >= 4.5, `${id}: hud meta`);
+    assert.ok(contrastRatio(t.accent, hudBg) >= 4.5, `${id}: hud accent`);
+    assert.ok(contrastRatio(t.badgeText, badgeBg) >= 4.5, `${id}: hud badge`);
+    assert.ok(contrastRatio(t.ui.ink, t.ui.sheet) >= 4.5, `${id}: ink on sheet`);
+    assert.ok(contrastRatio(t.ui.inkSoft, t.ui.surface) >= 4.5, `${id}: inkSoft on surface`);
+    assert.ok(contrastRatio(t.ui.muted, t.ui.heroBg) >= 4.5, `${id}: muted on heroBg`);
+    assert.ok(contrastRatio(t.ui.mutedSoft, t.ui.sheet) >= 4.5, `${id}: mutedSoft on sheet`);
+    assert.ok(contrastRatio(t.ui.topPickText, t.ui.topPickBg) >= 4.5, `${id}: topPick`);
+    assert.ok(contrastRatio(t.ui.primaryBtnText, t.ui.primaryBtnBg) >= 4.5, `${id}: primaryBtn`);
+    assert.ok(contrastRatio(t.ui.secondaryBtnText, t.ui.secondaryBtnBg) >= 4.5, `${id}: secondaryBtn`);
+    assert.ok(contrastRatio(t.ui.scorePillText, t.ui.scorePillBg) >= 4.5, `${id}: scorePill`);
+    assert.ok(contrastRatio(t.ui.kindText, t.ui.sheet) >= 4.5, `${id}: kindText on sheet`);
+    assert.ok(contrastRatio(t.map.label, t.map.ground) >= 4.5, `${id}: map label on ground`);
+    assert.ok(contrastRatio(t.map.label, t.map.town) >= 4.5, `${id}: map label on town`);
+    assert.ok(contrastRatio(t.map.rankTopText, t.map.rankTopBg) >= 4.5, `${id}: rankTop`);
+    assert.ok(contrastRatio(t.map.rankText, t.map.rankBg) >= 4.5, `${id}: rank`);
+    assert.ok(contrastRatio(t.compass.title, t.compass.bg) >= 4.5, `${id}: compass title`);
+    assert.ok(contrastRatio(t.compass.subtitle, t.compass.bg) >= 4.5, `${id}: compass subtitle`);
+  }
+});
